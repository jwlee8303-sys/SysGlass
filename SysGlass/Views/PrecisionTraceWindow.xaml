<Window x:Class="SysGlass.Views.PrecisionTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysGlass - 정밀 추적 (ETW)" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#1C1C1F" Foreground="#F2F2F2"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DA0A6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4D55"/>
            <Setter Property="CaretBrush" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#33363D"/>
            <Setter Property="BorderBrush" Value="#4A4D55"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#43474F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14">
        <TextBlock Text="Pool 할당 정밀 추적" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" LineHeight="19">
            Windows 기본 도구인 Windows Performance Recorder(wpr.exe)로 지정한 Pool Tag의 할당·반환 이벤트와 호출 스택을 기록합니다.
            기록 파일(.etl)을 Windows Performance Analyzer(WPA)로 열면 'Memory → Pool' 그래프에서 어떤 드라이버·호출 경로가 메모리를 할당하고 반환하지 않는지 확인할 수 있습니다.
        </TextBlock>

        <Border Background="#202024" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="시작 전에 확인하세요" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Hint}" LineHeight="19">
                    • 기록하는 동안 CPU·디스크 사용량이 늘고, 버퍼 크기만큼 RAM을 사용합니다. 할당이 잦은 태그일수록 부담이 큽니다.<LineBreak/>
                    • 지정한 시간이 지나면 자동으로 멈추고 저장합니다. 버퍼가 가득 차면 오래된 이벤트부터 덮어씁니다.<LineBreak/>
                    • 기록 파일에는 프로세스 이름, 드라이버·프로그램 경로, 호출 스택 주소, 컴퓨터 구성 정보가 들어갈 수 있습니다. 명령줄·환경 변수는 수집 대상으로 지정하지 않습니다.<LineBreak/>
                    • 파일은 이 PC에만 저장되며 외부로 전송하지 않습니다. 다른 사람에게 보낼 때는 내용을 확인하세요.<LineBreak/>
                    • 전용 세션 이름(SysGlassPool)을 사용하므로 다른 WPR·ETW 기록은 건드리지 않습니다. SysGlass를 종료하면 진행 중인 기록은 취소됩니다.<LineBreak/>
                    • 기록 결과는 원인 후보를 찾기 위한 자료이며, 스스로 원인을 확정하지 않습니다.
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Pool Tag" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="TagsBox" Grid.Column="1" Style="{StaticResource Input}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,3,0,6"
                       Text="쉼표로 구분, 최대 8개. 기본값은 최근 증가량이 큰 태그입니다. 비우면 모든 태그를 기록해 버퍼가 빨리 찹니다."/>
            <TextBlock Grid.Row="2" Text="기록 시간" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="MinutesBox" Style="{StaticResource Input}" Width="60" TextAlignment="Right"/>
                <TextBlock x:Name="MinutesHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,20,0"/>
                <TextBlock Text="버퍼" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="BufferBox" Style="{StaticResource Input}" Width="70" TextAlignment="Right"/>
                <TextBlock x:Name="BufferHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
            <CheckBox x:Name="ConsentBox" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" Foreground="#F2F2F2"
                      Content="위 내용을 확인했으며 정밀 추적 기록에 동의합니다." Checked="OnInputChanged" Unchecked="OnInputChanged"/>
        </Grid>

        <WrapPanel Margin="0,14,0,0">
            <Button x:Name="StartButton" Content="정밀 추적 시작" Click="OnStart"/>
            <Button x:Name="StopButton" Content="지금 멈추고 저장" Click="OnStop"/>
            <Button x:Name="CancelButton" Content="기록 취소(저장 안 함)" Click="OnCancel"/>
            <Button Content="추적 폴더 열기" Click="OnOpenFolder"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0"/>
    </StackPanel>
</Window>
