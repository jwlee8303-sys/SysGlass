<Window x:Class="SysGlass.Views.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SysGlass.ViewModels"
        xmlns:views="clr-namespace:SysGlass.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MemoryAnalysisViewModel}"
        Title="SysGlass - 메모리 상세 분석" Width="1040" Height="700" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#1C1C1F" Foreground="#F2F2F2"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DA0A6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 기존 프로세스 현황 창과 같은 머리글·행 스타일 -->
        <Style x:Key="HeaderBase" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#3A3A42"
                                    BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="False"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0"
                                   Cursor="SizeWE" Background="Transparent">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderLeft" TargetType="GridViewColumnHeader" BasedOn="{StaticResource HeaderBase}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="RowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#2B2B30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="0,4">
                            <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26262B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33414F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="List" TargetType="ListView">
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowStyle}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#33363D"/>
            <Setter Property="BorderBrush" Value="#4A4D55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#43474F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Filter" TargetType="TextBox">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4D55"/>
            <Setter Property="CaretBrush" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="14,8">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4CC2FF"/>
                                <Setter Property="Foreground" Value="#F2F2F2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26262B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 하단: 동작 버튼과 안내 -->
        <Border DockPanel.Dock="Bottom" Background="#222226" BorderBrush="#3A3A42" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel>
                <WrapPanel>
                    <Button Content="지금 진단 저장" Style="{StaticResource PlainButton}" Click="OnSaveNow"/>
                    <Button Content="진단 파일 내보내기..." Style="{StaticResource PlainButton}" Click="OnExportDiagnostic"/>
                    <Button Content="현재 표 CSV 내보내기..." Style="{StaticResource PlainButton}" Click="OnExportCsv"/>
                    <Button Content="진단 기록 폴더 열기" Style="{StaticResource PlainButton}" Click="OnOpenFolder"/>
                </WrapPanel>
                <TextBlock Text="{Binding DiagnosticStatus}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                           Text="표시 값은 누수 '의심'을 판단하기 위한 참고 자료입니다. 특정 드라이버·프로그램을 원인으로 확정하지 않습니다. 기록은 외부로 전송되지 않습니다."/>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="#3A3A42" Padding="0">
            <!-- 0. 개요·그래프 -->
            <TabItem Header="개요 · 그래프">
                <DockPanel Margin="14,10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OverviewText}" Margin="0,6,0,8" TextWrapping="Wrap" LineHeight="20"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="그래프 범위" Foreground="#9DA0A6" Margin="0,0,10,0"/>
                            <RadioButton Content="최근 1시간" GroupName="Range"
                                         IsChecked="{Binding ChartHours, Converter={StaticResource EqualsConv}, ConverterParameter=1}"/>
                            <RadioButton Content="최근 24시간" GroupName="Range"
                                         IsChecked="{Binding ChartHours, Converter={StaticResource EqualsConv}, ConverterParameter=24}"/>
                            <TextBlock Text="SysGlass 실행 이후 관측한 구간만 표시됩니다." Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#202024" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="6" Padding="6">
                        <views:MemoryChart Points="{Binding ChartPoints}" WarnMb="{Binding WarnMb}" MinHeight="200"/>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- 1. Pool Tag -->
            <TabItem Header="Pool Tag">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="14,0,14,6">
                        <WrapPanel>
                            <TextBlock Text="필터" Foreground="#9DA0A6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource Filter}" Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                     ToolTip="태그 또는 설명의 일부" Margin="0,0,12,0"/>
                            <Button Content="선택한 태그로 드라이버 후보 찾기" Style="{StaticResource PlainButton}" Click="OnSearchDrivers"
                                    IsEnabled="{Binding CanSearch}"/>
                            <Button Content="취소" Style="{StaticResource PlainButton}" Click="OnCancelSearch"
                                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding TagStatus}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBox DockPanel.Dock="Bottom" Text="{Binding SearchResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             MaxHeight="130" VerticalScrollBarVisibility="Auto" Background="#202024" Foreground="#C8C8C8"
                             BorderBrush="#3A3A42" Padding="10,6" Margin="0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchResult}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <ListView x:Name="TagList" Style="{StaticResource List}" ItemsSource="{Binding TagRows}"
                              SelectedItem="{Binding SelectedTag}" GridViewColumnHeader.Click="OnTagHeaderClick">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource HeaderBase}">
                                <GridViewColumn Width="80" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                    <GridViewColumn.Header><TextBlock Text="태그" Tag="Tag"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Tag}" Style="{StaticResource Cell}" FontFamily="Consolas" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="96">
                                    <GridViewColumn.Header><TextBlock Text="페이징" Tag="Paged"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PagedText}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="96">
                                    <GridViewColumn.Header><TextBlock Text="비페이징" Tag="NonPaged"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NonPagedText}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="96">
                                    <GridViewColumn.Header><TextBlock Text="합계" Tag="Total"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TotalText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="110">
                                    <GridViewColumn.Header><TextBlock Text="미반환 수" Tag="Outstanding" ToolTip="할당 횟수 - 반환 횟수"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding OutstandingText}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="100">
                                    <GridViewColumn.Header><TextBlock Text="10분 증가" Tag="Growth10m"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Growth10mText}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="100">
                                    <GridViewColumn.Header><TextBlock Text="1시간 증가" Tag="Growth1h"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Growth1hText}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="300" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                    <GridViewColumn.Header><TextBlock Text="알려진 용도 (참고)"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Description}" Style="{StaticResource Cell}" Foreground="#C8C8C8"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- 2. 프로세스 -->
            <TabItem Header="프로세스">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="14,0,14,6">
                        <WrapPanel>
                            <TextBlock Text="필터" Foreground="#9DA0A6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource Filter}" Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                     ToolTip="이름, 부모 이름 또는 PID"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ProcessStatus}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ListView x:Name="ProcList" Style="{StaticResource List}" ItemsSource="{Binding ProcessRows}" GridViewColumnHeader.Click="OnProcHeaderClick">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource HeaderBase}">
                                <GridViewColumn Width="190" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                    <GridViewColumn.Header><TextBlock Text="프로세스" Tag="Name"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="70">
                                    <GridViewColumn.Header><TextBlock Text="PID" Tag="Pid"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Pid}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="180" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                    <GridViewColumn.Header><TextBlock Text="부모" Tag="Parent"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Parent}" Style="{StaticResource Cell}" Foreground="#C8C8C8"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="100">
                                    <GridViewColumn.Header><TextBlock Text="Private" Tag="Private"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PrivateText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="100">
                                    <GridViewColumn.Header><TextBlock Text="1시간 변화" Tag="PrivateChange"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PrivateChangeText}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="90">
                                    <GridViewColumn.Header><TextBlock Text="핸들" Tag="Handles"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding HandlesText}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="110">
                                    <GridViewColumn.Header><TextBlock Text="핸들 1시간 변화" Tag="HandleChange"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding HandleChangeText}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="100">
                                    <GridViewColumn.Header><TextBlock Text="Working Set" Tag="WorkingSet"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding WorkingSetText}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="80">
                                    <GridViewColumn.Header><TextBlock Text="스레드" Tag="Threads"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Threads}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- 3. 프로세스 생성·종료 -->
            <TabItem Header="생성 · 종료">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding EventStatus}" Style="{StaticResource Hint}" Margin="14,0,14,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="최근 1시간 생성 횟수 상위" Foreground="#9DA0A6" Margin="14,0,0,4"/>
                            <ListView Style="{StaticResource List}" ItemsSource="{Binding TopStarters}">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource HeaderBase}">
                                        <GridViewColumn Header="이름" Width="190" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="횟수" Width="80">
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Count}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                        <DockPanel Grid.Column="1">
                            <TextBlock DockPanel.Dock="Top" Text="최근 이벤트 (최대 300건)" Foreground="#9DA0A6" Margin="14,0,0,4"/>
                            <ListView Style="{StaticResource List}" ItemsSource="{Binding RecentEvents}">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource HeaderBase}">
                                        <GridViewColumn Header="시각" Width="90" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Time}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="구분" Width="60" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="PID" Width="70">
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Pid}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="부모 PID" Width="80">
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ParentPid}" Style="{StaticResource Num}"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="이름" Width="240" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- 4. 이상 이력 -->
            <TabItem Header="이상 이력">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="14,0,14,8"
                               Text="최근 두 달의 알림 기록과 이번 실행의 알림입니다 (최대 500건). 같은 알림은 재발송 간격마다, 악화 시 즉시 기록됩니다."/>
                    <ListView Style="{StaticResource List}" ItemsSource="{Binding AlertRows}">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource HeaderBase}">
                                <GridViewColumn Header="시각" Width="150" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TimeText}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="상태" Width="70" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontWeight="SemiBold" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="항목" Width="170" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Label}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="값" Width="120" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Value}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="기준" Width="260" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Threshold}" Style="{StaticResource Cell}" Foreground="#C8C8C8"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="비고" Width="100" HeaderContainerStyle="{StaticResource HeaderLeft}">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Flags}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
