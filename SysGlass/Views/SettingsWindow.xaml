<Window x:Class="SysGlass.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SysGlass.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="SysGlass 설정" Width="440" Height="700" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#1C1C1F" Foreground="#F2F2F2"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DA0A6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4CC2FF"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DA0A6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="BorderBrush" Value="#3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Margin" Value="0,2,16,2"/>
        </Style>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#33363D"/>
            <Setter Property="BorderBrush" Value="#4A4D55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#43474F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Background" Value="#1C1C1F"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#4A4D55"/>
            <Setter Property="CaretBrush" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
</Window.Resources>

    <DockPanel>
        <!-- 하단: 기본값 복원 / 닫기 -->
        <Border DockPanel.Dock="Bottom" Background="#222226" BorderBrush="#3A3A42" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="기본값 복원" Style="{StaticResource PlainButton}" Click="OnReset"/>
                <Button DockPanel.Dock="Right" Content="닫기" Style="{StaticResource PlainButton}" Click="OnCloseClick"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,16,16,4">

                <!-- 1. 표시 항목 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="표시 항목" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="CPU" Style="{StaticResource SubTitle}" Margin="0,0,0,4"/>
                        <CheckBox Content="CPU 사용률" IsChecked="{Binding ShowCpuUsage}"/>
                        <CheckBox Content="CPU Package 온도" IsChecked="{Binding ShowCpuTemp}"/>
                        <CheckBox Content="CPU Package 전력" IsChecked="{Binding ShowCpuPower}"/>
                        <CheckBox Content="CPU 클럭" IsChecked="{Binding ShowCpuClock}"/>
                        <TextBlock Text="메모리" Style="{StaticResource SubTitle}"/>
                        <CheckBox Content="RAM 사용량 및 사용률" IsChecked="{Binding ShowRamUsage}"/>
                        <CheckBox Content="Paged Pool (페이징 풀 및 상주량)" IsChecked="{Binding ShowPagedPool}"/>
                        <CheckBox Content="NonPaged Pool (비페이징 풀)" IsChecked="{Binding ShowNonPagedPool}"/>
                        <CheckBox Content="Pool Growth (최근 10분·1시간 풀 증가량)" IsChecked="{Binding ShowPoolGrowth}"/>
                        <CheckBox Content="Uptime (시스템 가동 시간)" IsChecked="{Binding ShowUptime}"/>
                        <CheckBox Content="Memory Status (메모리 감시 상태)" IsChecked="{Binding ShowMemoryStatus}"/>
                        <TextBlock Text="GPU" Style="{StaticResource SubTitle}"/>
                        <CheckBox Content="GPU 사용률" IsChecked="{Binding ShowGpuUsage}"/>
                        <CheckBox Content="GPU 온도" IsChecked="{Binding ShowGpuTemp}"/>
                        <CheckBox Content="VRAM 사용량 및 사용률" IsChecked="{Binding ShowVram}"/>
                        <TextBlock Text="디스크" Style="{StaticResource SubTitle}"/>
                        <CheckBox Content="디스크 사용률" IsChecked="{Binding ShowDiskUsage}"/>
                        <CheckBox Content="디스크 온도" IsChecked="{Binding ShowDiskTemp}"/>
                        <CheckBox Content="디스크 읽기 속도" IsChecked="{Binding ShowDiskRead}"/>
                        <CheckBox Content="디스크 쓰기 속도" IsChecked="{Binding ShowDiskWrite}"/>
                        <TextBlock Text="네트워크" Style="{StaticResource SubTitle}"/>
                        <CheckBox Content="다운로드 속도" IsChecked="{Binding ShowNetDown}"/>
                        <CheckBox Content="업로드 속도" IsChecked="{Binding ShowNetUp}"/>
                    </StackPanel>
                </Border>

                <!-- 2. 하드웨어 선택 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="하드웨어 선택" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="GPU (여러 개 선택 가능)" Style="{StaticResource SubTitle}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Gpus.Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayLabel}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="감지된 GPU가 없습니다.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Gpus.Choices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="물리 디스크" Style="{StaticResource SubTitle}"/>
                        <ItemsControl ItemsSource="{Binding Disks.Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayLabel}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="감지된 물리 디스크가 없습니다.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Disks.Choices.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>                        <TextBlock Text="물리 디스크 기준이며 C:, D: 같은 논리 드라이브와는 다릅니다. 선택은 모델명과 식별 정보로 저장되어 연결 순서가 바뀌어도 유지됩니다."
                                   Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. 화면 및 디자인 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="화면 및 디자인" Style="{StaticResource SectionTitle}"/>

                        <DockPanel>
                            <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Width="48" TextAlignment="Right"/>
                            <TextBlock Text="배경 투명도(불투명도)"/>
                        </DockPanel>
                        <Slider Minimum="20" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                                Value="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="배경만 투명해지며 글자와 막대는 선명하게 유지됩니다." Style="{StaticResource Hint}"/>

                        <TextBlock Text="글자 크기" Style="{StaticResource SubTitle}" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="작게" GroupName="Font" IsChecked="{Binding FontSizeLevel, Converter={StaticResource EqualsConv}, ConverterParameter=0}"/>
                            <RadioButton Content="보통" GroupName="Font" IsChecked="{Binding FontSizeLevel, Converter={StaticResource EqualsConv}, ConverterParameter=1}"/>
                            <RadioButton Content="크게" GroupName="Font" IsChecked="{Binding FontSizeLevel, Converter={StaticResource EqualsConv}, ConverterParameter=2}"/>
                        </StackPanel>

                        <CheckBox Content="컴팩트 보기" IsChecked="{Binding CompactMode}" Margin="0,12,0,0"/>
                        <TextBlock Text="사용률 막대를 숨기고 항목 간격과 CPU 사용률 글씨를 줄여 창을 작게 보여 줍니다." Style="{StaticResource Hint}"/>

                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Text="{Binding WindowWidth, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Width="64" TextAlignment="Right"/>
                            <TextBlock Text="창 너비"/>
                        </DockPanel>
                        <Slider Minimum="{Binding MinWindowWidth}" Maximum="{Binding MaxWindowWidth}" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,4,0,0"
                                Value="{Binding WindowWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="높이는 표시 항목에 따라 자동으로 조절됩니다." Style="{StaticResource Hint}"/>

                        <CheckBox Content="항상 위에 표시" IsChecked="{Binding AlwaysOnTop}" Margin="0,12,0,3"/>
                        <CheckBox Content="마우스 클릭 통과 (Ctrl+Alt+F10)" IsChecked="{Binding ClickThrough}"/>
                        <TextBlock Text="켜면 SysGlass 창이 마우스 입력을 받지 않습니다. 트레이 메뉴나 단축키로 언제든 해제할 수 있습니다."
                                   Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>

                <!-- 4. 온도 경고 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="온도 경고" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="기준 이상이면 주의(노랑), 경고 기준 이상이면 빨강으로 표시됩니다. 기본값은 참고용이며 하드웨어의 안전 한계를 의미하지 않습니다. 센서값이 N/A이면 색상을 적용하지 않습니다."
                                   Style="{StaticResource Hint}" Margin="0,0,0,8"/>

                        <TextBlock Text="CPU" Style="{StaticResource SubTitle}" Margin="0,4,0,2"/>
                        <DockPanel>
                            <TextBlock Text="{Binding CpuTempWarn, StringFormat={}{0:0}°C}" DockPanel.Dock="Right" Width="52" TextAlignment="Right"/>
                            <TextBlock Text="주의" Width="40"/>
                            <Slider Minimum="{Binding TempMin}" Maximum="{Binding TempMax}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding CpuTempWarn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding CpuTempHigh, StringFormat={}{0:0}°C}" DockPanel.Dock="Right" Width="52" TextAlignment="Right"/>
                            <TextBlock Text="경고" Width="40"/>
                            <Slider Minimum="{Binding TempMin}" Maximum="{Binding TempMax}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding CpuTempHigh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="GPU" Style="{StaticResource SubTitle}"/>
                        <DockPanel>
                            <TextBlock Text="{Binding GpuTempWarn, StringFormat={}{0:0}°C}" DockPanel.Dock="Right" Width="52" TextAlignment="Right"/>
                            <TextBlock Text="주의" Width="40"/>
                            <Slider Minimum="{Binding TempMin}" Maximum="{Binding TempMax}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding GpuTempWarn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding GpuTempHigh, StringFormat={}{0:0}°C}" DockPanel.Dock="Right" Width="52" TextAlignment="Right"/>
                            <TextBlock Text="경고" Width="40"/>
                            <Slider Minimum="{Binding TempMin}" Maximum="{Binding TempMax}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding GpuTempHigh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="디스크" Style="{StaticResource SubTitle}"/>
                        <DockPanel>
                            <TextBlock Text="{Binding DiskTempWarn, StringFormat={}{0:0}°C}" DockPanel.Dock="Right" Width="52" TextAlignment="Right"/>
                            <TextBlock Text="주의" Width="40"/>
                            <Slider Minimum="{Binding TempMin}" Maximum="{Binding TempMax}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding DiskTempWarn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding DiskTempHigh, StringFormat={}{0:0}°C}" DockPanel.Dock="Right" Width="52" TextAlignment="Right"/>
                            <TextBlock Text="경고" Width="40"/>
                            <Slider Minimum="{Binding TempMin}" Maximum="{Binding TempMax}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding DiskTempHigh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 메모리 감시 -->
                <Border x:Name="MemoryCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="메모리 감시" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="메모리 감시 사용" IsChecked="{Binding MemoryWatchEnabled}"/>
                        <CheckBox Content="이상 상태를 트레이 알림으로 표시" IsChecked="{Binding MemAlertsEnabled}"/>
                        <TextBlock Text="절대 사용량과 최근 1시간 증가 추세를 함께 판단합니다. 기준을 넘은 상태가 지속 시간 이상 이어지면 알리고, 같은 알림은 재발송 간격마다, 상태가 악화되면 즉시 다시 알립니다. 알림은 누수 의심 단계이며 원인을 확정하지 않습니다."
                                   Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <DockPanel Margin="0,10,0,2">
                            <TextBlock DockPanel.Dock="Right" Text="위험" Width="72" TextAlignment="Center" Style="{StaticResource Hint}"/>
                            <TextBlock DockPanel.Dock="Right" Text="주의" Width="72" Margin="0,0,6,0" TextAlignment="Center" Style="{StaticResource Hint}"/>
                            <TextBlock Text="감지 기준" Style="{StaticResource SubTitle}" Margin="0"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemPagedHighMb}"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemPagedWarnMb}" Margin="0,0,6,0"/>
                            <TextBlock Text="페이징 풀 (MB)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemNonPagedHighMb}"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemNonPagedWarnMb}" Margin="0,0,6,0"/>
                            <TextBlock Text="비페이징 풀 (MB)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemPoolTagHighMb}"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemPoolTagWarnMb}" Margin="0,0,6,0"/>
                            <TextBlock Text="개별 Pool Tag (MB)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemGrowthHighMbPerHour}"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemGrowthWarnMbPerHour}" Margin="0,0,6,0"/>
                            <TextBlock Text="시간당 풀 증가량 (MB/h)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemCommitHighPercent}"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemCommitWarnPercent}" Margin="0,0,6,0"/>
                            <TextBlock Text="커밋 사용률 (% 이상)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemAvailHighPercent}"/>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemAvailWarnPercent}" Margin="0,0,6,0"/>
                            <TextBlock Text="가용 RAM 비율 (% 이하)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="입력 후 다른 칸으로 이동하면 적용됩니다. 주의와 위험 기준이 뒤바뀌지 않도록 자동 보정됩니다."
                                   Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBlock Text="알림 시점" Style="{StaticResource SubTitle}"/>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemAlertSustainMin}"/>
                            <TextBlock Text="이상 상태 지속 시간 (분)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemAlertRepeatMin}"/>
                            <TextBlock Text="같은 알림 재발송 간격 (분)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="상태 색상" Style="{StaticResource SubTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="기본 (노랑/빨강)" GroupName="MemColor" IsChecked="{Binding MemColorScheme, Converter={StaticResource EqualsConv}, ConverterParameter=0}"/>
                            <RadioButton Content="고대비 (주황/자홍)" GroupName="MemColor" IsChecked="{Binding MemColorScheme, Converter={StaticResource EqualsConv}, ConverterParameter=1}"/>
                        </StackPanel>
                        <TextBlock Text="수집 주기 (초)" Style="{StaticResource SubTitle}"/>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemKernelIntervalSec}"/>
                            <TextBlock Text="커널 메모리 (1~60)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemResidentIntervalSec}"/>
                            <TextBlock Text="페이징 풀 상주량 (5~600)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemPoolTagIntervalSec}"/>
                            <TextBlock Text="Pool Tag (15~3600)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemProcessIntervalSec}"/>
                            <TextBlock Text="프로세스 정보 (15~3600)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemUptimeIntervalSec}"/>
                            <TextBlock Text="시스템 가동 시간 (5~3600)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="기록" Style="{StaticResource SubTitle}"/>
                        <CheckBox Content="요약 로그와 이상 감지 시 상세 진단 파일 저장" IsChecked="{Binding MemLogEnabled}"/>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemRetentionDays}"/>
                            <TextBlock Text="보존 기간 (일, 1~365)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumBox}" Text="{Binding MemLogMaxMb}"/>
                            <TextBlock Text="기록 최대 용량 (MB, 10~4096)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="기록은 %AppData%\SysGlass\memory에 CSV·JSON으로 저장되며 외부로 전송되지 않습니다. 기간이나 용량을 넘으면 오래된 기록부터 지웁니다. 명령줄·환경 변수·인증 정보는 수집하지 않습니다."
                                   Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <Button Content="진단 기록 폴더 열기" Style="{StaticResource PlainButton}" Click="OnOpenMemoryLogs" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 5. 동작 및 갱신 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="동작 및 갱신" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="센서 갱신 주기"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton Content="0.5초" GroupName="Interval" IsChecked="{Binding RefreshIntervalMs, Converter={StaticResource EqualsConv}, ConverterParameter=500}"/>
                            <RadioButton Content="1초" GroupName="Interval" IsChecked="{Binding RefreshIntervalMs, Converter={StaticResource EqualsConv}, ConverterParameter=1000}"/>
                            <RadioButton Content="2초" GroupName="Interval" IsChecked="{Binding RefreshIntervalMs, Converter={StaticResource EqualsConv}, ConverterParameter=2000}"/>
                            <RadioButton Content="5초" GroupName="Interval" IsChecked="{Binding RefreshIntervalMs, Converter={StaticResource EqualsConv}, ConverterParameter=5000}"/>
                        </StackPanel>
                        <TextBlock Text="주기가 짧을수록 값이 빨리 갱신되지만 프로그램 부하가 조금 늘어납니다." Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>

                <!-- 6. 기본값 복원 안내 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="기본값 복원" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="아래 왼쪽의 [기본값 복원] 버튼으로 표시 항목, 디자인, 갱신 주기, 온도 기준 등을 기본값으로 되돌립니다. 확인 창에서 창 위치와 너비까지 복원할지 선택할 수 있습니다."
                                   Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>

                <!-- 7. 버전 정보 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="버전 정보" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding AppVersionText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
