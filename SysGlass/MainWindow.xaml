<Window x:Class="SysGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SysGlass.ViewModels"
        xmlns:views="clr-namespace:SysGlass.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SysGlass"
        SizeToContent="Height" Width="280" MinWidth="200" MaxWidth="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="{DynamicResource FsBase}"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- 글자 크기 단계에 따라 코드에서 갱신되는 크기 리소스 -->
        <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="FsBase">13</sys:Double>
        <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="FsLabel">11</sys:Double>
        <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="FsLarge">16</sys:Double>
        <!-- 설정의 글자 색에 따라 코드에서 갱신되는 색 리소스(본문·수치, 항목 이름) -->
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#9D9D9D"/>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UsageBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#4CC2FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FsLabel}"/>
        </Style>
        <!-- 구역 아래 여백. 컴팩트 보기에서는 간격을 줄인다 -->
        <Style x:Key="Section" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 컴팩트 보기: 배터리 위젯형 캡슐 칸 -->
        <DataTemplate x:Key="CapsuleTile">
            <StackPanel Margin="3,0,3,8" ToolTip="{Binding ToolTip}" Background="Transparent">
                <Grid Height="26">
                    <views:UsageGauge Kind="Capsule" Value="{Binding Percent}" Fill="{Binding Accent}"/>
                    <DockPanel Margin="10,0">
                        <TextBlock Text="{Binding ValueText}" Foreground="{Binding ValueBrush}" FontWeight="SemiBold"
                                   DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>
                <TextBlock Text="{Binding SubText}" Foreground="{Binding SubBrush}" FontSize="{DynamicResource FsLabel}"
                           Margin="10,2,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasSub, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
        <!-- 추이 그래프: 이름·값 아래에 최근 사용률 변화를 면 그래프로 표시 -->
        <DataTemplate x:Key="GraphTile">
            <StackPanel Margin="3,0,3,8" ToolTip="{Binding ToolTip}" Background="Transparent">
                <DockPanel>
                    <TextBlock Text="{Binding ValueText}" Foreground="{Binding ValueBrush}" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <views:UsageGauge Kind="History" Height="28" Margin="0,3,0,0" Value="{Binding Percent}" Fill="{Binding Accent}"
                                  History="{Binding History}" HistoryLength="{x:Static vm:CompactTileViewModel.HistoryLength}"/>
                <TextBlock Text="{Binding SubText}" Foreground="{Binding SubBrush}" FontSize="{DynamicResource FsLabel}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasSub, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
        <!-- LED 미터: 한 줄에 한 항목, 레벨미터처럼 칸이 켜짐. 이름·값 열 너비를 항목끼리 맞춘다 -->
        <DataTemplate x:Key="LedTile">
            <!-- 목록의 왼쪽 -2 여백을 상쇄해 이름 첫 글자가 잘리지 않게 한다 -->
            <Grid Margin="3,0,3,6" ToolTip="{Binding ToolTip}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LedLabel"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LedValue"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LedSub"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <views:UsageGauge Grid.Column="1" Kind="Segments" SegmentCount="20" Height="10" VerticalAlignment="Center"
                                  Value="{Binding Percent}" Fill="{Binding Accent}"/>
                <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{Binding ValueBrush}" FontWeight="SemiBold"
                           TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="3" Text="{Binding SubText}" Foreground="{Binding SubBrush}" FontSize="{DynamicResource FsLabel}"
                           VerticalAlignment="Center" Margin="6,0,0,0"
                           Visibility="{Binding HasSub, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>
        <!-- 아크 게이지: 계기판형 270° 호 가운데에 값, 아래에 이름 표시.
             크기는 열 수(2·3·4열)에 따라 정하고, 칸이 그보다 좁으면 Viewbox로 줄인다.
             가운데 값은 호 안쪽 폭을 넘으면 글자를 줄여 호에 닿지 않게 한다 -->
        <DataTemplate x:Key="ArcTile">
            <StackPanel Margin="2,0,2,8" ToolTip="{Binding ToolTip}" Background="Transparent">
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center"
                         MaxWidth="{Binding DataContext.ArcTileSize, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid Width="{Binding DataContext.ArcTileSize, RelativeSource={RelativeSource AncestorType=Window}}"
                          Height="{Binding DataContext.ArcTileSize, RelativeSource={RelativeSource AncestorType=Window}}">
                        <views:UsageGauge Kind="Arc" Thickness="5" Value="{Binding Percent}" Fill="{Binding Accent}"/>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 MaxWidth="{Binding DataContext.ArcValueWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="{Binding ValueText}" Foreground="{Binding ValueBrush}" FontWeight="SemiBold"/>
                        </Viewbox>
                    </Grid>
                </Viewbox>
                <!-- 호 아래 트인 공간만큼 끌어올린다(호 끝보다는 아래라 겹치지 않음) -->
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,-6,0,0"/>
                <TextBlock Text="{Binding SubText}" Foreground="{Binding SubBrush}" FontSize="{DynamicResource FsLabel}"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Visibility="{Binding HasSub, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="OneColumn"><StackPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ArcColumns">
            <UniformGrid Columns="{Binding DataContext.ArcColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="TwoColumns"><UniformGrid Columns="2"/></ItemsPanelTemplate>

        <DrawingImage x:Key="TaskManagerFallbackIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#203D50" Geometry="M1,2 H15 V12 H1 Z">
                        <GeometryDrawing.Pen><Pen Brush="#76CCF5" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M2,9 H5 L7,5 9,10 11,7 H14 M5,15 H11 M8,12 V15">
                        <GeometryDrawing.Pen><Pen Brush="#76CCF5" Thickness="1.2"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="ComputerManagementFallbackIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#487FA6" Geometry="M1,2 H12 V11 H1 Z">
                        <GeometryDrawing.Pen><Pen Brush="#B9D7EB" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M6,11 V14 M3,14 H9">
                        <GeometryDrawing.Pen><Pen Brush="#B9D7EB" Thickness="1.5"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#B5BEC8" Geometry="M10,7 H14 V8 H15 V12 H14 V13 H10 V12 H9 V8 H10 Z"/>
                    <GeometryDrawing Brush="#38536C">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="12,10" RadiusX="1.5" RadiusY="1.5"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <!-- 창 전체 Opacity 대신 배경 브러시 알파만 조절하여 글자를 선명하게 유지 -->
    <Border Background="{Binding BackgroundBrush}" BorderBrush="#40FFFFFF" BorderThickness="1"
            CornerRadius="10" Padding="12,8,12,4"
            MouseLeftButtonDown="OnDrag">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="SysGlass" FontWeight="SemiBold" Foreground="#C8C8C8" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleButton}" ToolTip="작업 관리자" AutomationProperties.Name="작업 관리자" Click="OnOpenTaskManager">
                        <Image x:Name="TaskManagerIcon" Source="{StaticResource TaskManagerFallbackIcon}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource TitleButton}" ToolTip="컴퓨터 관리" AutomationProperties.Name="컴퓨터 관리" Click="OnOpenComputerManagement">
                        <Image x:Name="ComputerManagementIcon" Source="{StaticResource ComputerManagementFallbackIcon}" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource TitleButton}" Content="📊" ToolTip="자원별 프로세스 점유 현황" Click="OnOpenProcesses"/>
                    <Button Style="{StaticResource TitleButton}" Content="⚙" ToolTip="설정" Click="OnOpenSettings"/>
                    <Button Style="{StaticResource TitleButton}" Content="—" ToolTip="최소화" Click="OnMinimize"/>
                    <Button Style="{StaticResource TitleButton}" Content="✕" ToolTip="종료" Click="OnClose"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- 각 구역은 아래쪽 여백만 가지므로 숨겨진 구역은 빈 공간을 남기지 않는다.
                     Group* 블록은 설정의 그룹 순서에 따라 코드에서 재배치한다(MainWindow.ApplyGroupOrder). -->
                <StackPanel x:Name="GroupHost">
                    <!-- 표시할 항목이 없을 때 안내 -->
                    <TextBlock Text="표시할 항목이 없습니다.&#x0A;⚙ 설정에서 항목을 선택하세요." Style="{StaticResource Label}"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                    <!-- 컴팩트 보기: 위젯형 칸 -->
                    <ItemsControl x:Name="CompactTilesPanel" ItemsSource="{Binding CompactTiles}" Margin="-2,0,-2,2" Focusable="False"
                                  Grid.IsSharedSizeScope="True"
                                  Visibility="{Binding CompactMode, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <!-- 기본값: 아크 게이지(4). 1~3은 아래 트리거로 바꾼다 -->
                                <Setter Property="ItemTemplate" Value="{StaticResource ArcTile}"/>
                                <Setter Property="ItemsPanel" Value="{StaticResource ArcColumns}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompactStyle}" Value="1">
                                        <Setter Property="ItemTemplate" Value="{StaticResource CapsuleTile}"/>
                                        <Setter Property="ItemsPanel" Value="{StaticResource TwoColumns}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CompactStyle}" Value="2">
                                        <Setter Property="ItemTemplate" Value="{StaticResource GraphTile}"/>
                                        <Setter Property="ItemsPanel" Value="{StaticResource TwoColumns}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CompactStyle}" Value="3">
                                        <Setter Property="ItemTemplate" Value="{StaticResource LedTile}"/>
                                        <Setter Property="ItemsPanel" Value="{StaticResource OneColumn}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <!-- CPU (일반 보기) -->
                    <StackPanel x:Name="GroupCpu" Visibility="{Binding ShowNormalView, Converter={StaticResource BoolToVis}}">
                    <StackPanel Style="{StaticResource Section}" Visibility="{Binding ShowCpuBlock, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding CpuText}" FontSize="{DynamicResource FsLarge}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       Visibility="{Binding ShowCpuUsage, Converter={StaticResource BoolToVis}}"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding CpuPercent, Mode=OneWay}" Margin="0,4,0,0"
                                     Visibility="{Binding ShowCpuUsage, Converter={StaticResource BoolToVis}}"/>
                        <DockPanel Margin="0,4,0,0" Visibility="{Binding ShowCpuSubRow, Converter={StaticResource BoolToVis}}"
                                   ToolTip="{Binding CpuName}">
                            <TextBlock Text="{Binding CpuTempText}" Foreground="{Binding CpuTempBrush}" ToolTip="{Binding SensorNotice}"
                                       Visibility="{Binding ShowCpuTemp, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding CpuPowerText}" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                       Visibility="{Binding ShowCpuPower, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding CpuClockText}" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Visibility="{Binding ShowCpuClock, Converter={StaticResource BoolToVis}}"/>
                        </DockPanel>
                    </StackPanel>

                    </StackPanel>

                    <!-- RAM (일반 보기) -->
                    <StackPanel x:Name="GroupRam" Visibility="{Binding ShowNormalView, Converter={StaticResource BoolToVis}}">
                    <StackPanel Style="{StaticResource Section}" Visibility="{Binding ShowRamUsage, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock Text="RAM" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding RamText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding RamPercent, Mode=OneWay}" Foreground="#9CDB7F" Margin="0,4,0,0"/>
                    </StackPanel>

                    </StackPanel>

                    <!-- 커널 메모리: 측정하지 못한 값은 N/A·미측정으로 표시 -->
                    <StackPanel x:Name="GroupMemory" Style="{StaticResource Section}" DataContext="{Binding Memory}"
                                Visibility="{Binding DataContext.ShowKernelMemory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <DockPanel ToolTip="{Binding PagedPoolTip}"
                                   Visibility="{Binding DataContext.ShowPagedPool, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Paged Pool" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding PagedPoolText}" Foreground="{Binding PagedPoolBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,2,0,0" ToolTip="{Binding NonPagedPoolTip}"
                                   Visibility="{Binding DataContext.ShowNonPagedPool, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="NonPaged Pool" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding NonPagedPoolText}" Foreground="{Binding NonPagedPoolBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,2,0,0" ToolTip="{Binding PoolGrowthTip}"
                                   Visibility="{Binding DataContext.ShowPoolGrowth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Pool Growth" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding PoolGrowthText}" Foreground="{Binding PoolGrowthBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <DockPanel Margin="0,2,0,0" ToolTip="{Binding UptimeTip}"
                                   Visibility="{Binding DataContext.ShowUptime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Uptime" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding UptimeText}" Foreground="{Binding UptimeBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,2,0,0" ToolTip="{Binding StatusTip}"
                                   Visibility="{Binding DataContext.ShowMemoryStatus, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Memory Status" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- GPU (일반 보기): 선택된 GPU를 목록으로 표시 -->
                    <StackPanel x:Name="GroupGpu" Visibility="{Binding ShowNormalView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Gpus}"
                                  Visibility="{Binding ShowGpuSection, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Style="{StaticResource Section}">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                                    <DockPanel Margin="0,2,0,0"
                                               Visibility="{Binding DataContext.ShowGpuHeader, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="GPU" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding UsageText}" FontWeight="SemiBold"
                                                       Visibility="{Binding DataContext.ShowGpuUsage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text=" / " Foreground="{DynamicResource LabelBrush}"
                                                       Visibility="{Binding DataContext.ShowGpuBoth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding TempText}" Foreground="{Binding TempBrush}"
                                                       Visibility="{Binding DataContext.ShowGpuTemp, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding Usage, Mode=OneWay}" Foreground="#C79BFF" Margin="0,4,0,0"
                                                 Visibility="{Binding DataContext.ShowGpuUsage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Visibility="{Binding DataContext.ShowVram, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Text="VRAM" Style="{StaticResource Label}"/>
                                            <TextBlock Text="{Binding VramText}" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding VramPercent, Mode=OneWay}" Foreground="#E6A3FF" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>

                    <!-- 물리 디스크 (일반 보기): 선택된 디스크만 -->
                    <StackPanel x:Name="GroupDisk" Visibility="{Binding ShowNormalView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Disks}"
                                  Visibility="{Binding ShowDiskSection, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Style="{StaticResource Section}" ToolTip="{Binding Model}">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding UsageText}"
                                                       Visibility="{Binding DataContext.ShowDiskUsage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text=" / " Foreground="{DynamicResource LabelBrush}"
                                                       Visibility="{Binding DataContext.ShowDiskBoth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding TempText}" Foreground="{Binding TempBrush}"
                                                       Visibility="{Binding DataContext.ShowDiskTemp, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding Usage, Mode=OneWay}" Foreground="#FFB86B" Margin="0,4,0,0"
                                                 Visibility="{Binding DataContext.ShowDiskUsage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding IoText}" Style="{StaticResource Label}" Margin="0,3,0,0"
                                               Visibility="{Binding DataContext.ShowDiskIo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>

                    <!-- 네트워크 -->
                    <DockPanel x:Name="GroupNet" Margin="0,0,0,8" Visibility="{Binding ShowNetwork, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="NET" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="↓ " Foreground="{DynamicResource LabelBrush}" Visibility="{Binding ShowNetDown, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding NetDownText}" Visibility="{Binding ShowNetDown, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="   " Visibility="{Binding ShowNetBoth, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="↑ " Foreground="{DynamicResource LabelBrush}" Visibility="{Binding ShowNetUp, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding NetUpText}" Visibility="{Binding ShowNetUp, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
